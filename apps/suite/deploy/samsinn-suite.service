[Unit]
Description=Samsinn + Leitbild Workspace coordinator
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=samsinn-suite
Group=samsinn-suite
WorkingDirectory=/opt/samsinn-suite/current/apps/suite
Environment=PORT=3100
Environment=BIND_HOST=127.0.0.1
Environment=SUITE_HOME=/var/lib/samsinn-suite
Environment=SAMSINN_URL=https://samsinn.app
Environment=LEITBILD_URL=https://leitbild.samsinn.app
ExecStart=/opt/leitbild/runtime/bun run src/index.ts
Restart=on-failure
RestartSec=5s

MemoryMax=256M
CPUQuota=50%
LimitNOFILE=4096
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/samsinn-suite
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
RemoveIPC=true

[Install]
WantedBy=multi-user.target
