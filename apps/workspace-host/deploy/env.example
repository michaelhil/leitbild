# Sample /etc/workspace-host/env for the combined distribution.
# Keep JSON values on one line; systemd EnvironmentFile does not parse shell arrays.

WORKSPACE_HOST_URL=https://samsinn.app
WORKSPACE_MODULES=[{"moduleId":"microworld","baseUrl":"http://127.0.0.1:4177","manifestPath":"/.well-known/workspace-module"},{"moduleId":"collaboration","baseUrl":"http://127.0.0.1:3000","manifestPath":"/.well-known/workspace-module/collaboration"},{"moduleId":"agents","baseUrl":"http://127.0.0.1:3000","manifestPath":"/.well-known/workspace-module/agents"}]
WORKSPACE_EXPERIENCES=[{"id":"leitbild","title":"Leitbild","requiredModules":["microworld"],"entryModuleId":"microworld"},{"id":"samsinn","title":"Samsinn","requiredModules":["collaboration","agents"],"entryModuleId":"collaboration"}]
INITIAL_EXPERIENCE_IDS=["leitbild","samsinn"]
