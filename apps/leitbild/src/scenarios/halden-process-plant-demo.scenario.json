  "script": {
    "steps": [
      {
        "id": "scenario-started",
        "at": { "kind": "after_scenario_start", "seconds": 0 },
        "actions": [
          {
            "type": "show_guidance",
            "guidance": {
              "id": "halden-process-welcome",
              "title": "Halden process-plant demo",
              "message": "Seven process-plant units are running near Halden, including a Halden 6-loop variant with six steam generators. Watch Unit A2 and Unit B1 as scheduled faults develop. The plant rail values are projected from the process runtime; click the eye icon to choose which values stay visible.",
              "objectIds": ["plant:halden-a2", "plant:halden-b1", "plant:halden-6-loop", "amb:demo-reserve-1"],
              "dismissible": true
            }
          },
          {
            "type": "highlight_objects",
            "objectIds": ["plant:halden-a2", "plant:halden-b1", "plant:halden-6-loop", "amb:demo-reserve-1"]
          }
        ]
      },
      {
        "id": "plant-medical-demand",
        "at": { "kind": "after_scenario_start", "seconds": 30 },
        "actions": [
          {
            "type": "emit_signal",
            "signal": {
              "id": "signal:halden-a2-medical-demand",
              "source": { "kind": "object", "id": "plant:halden-a2" },
              "targets": [{ "kind": "role", "id": "medical-transport" }],
              "signalType": "operational.demand.requested",
              "severity": "warning",
              "payload": {
                "schemaVersion": 1,
                "demandId": "halden-a2-medical-demand",
                "capability": "medical.transport",
                "sourceObjectId": "plant:halden-a2",
                "location": { "type": "Point", "coordinates": [11.3744, 59.1206] },
                "quantity": 2,
                "severity": "warning",
                "title": "Medical pickup requested at Unit A2",
                "description": "Plant Unit A2 requests medical transport for two people at the site access point."
              }
            }
          }
        ]
      },
      {
        "id": "a2-sgtr-guidance",
        "at": { "kind": "after_scenario_start", "seconds": 70 },
        "actions": [
          {
            "type": "show_guidance",
            "guidance": {
              "id": "a2-sgtr-started",
              "title": "Unit A2 abnormal indication",
              "tone": "update",
              "message": "Unit A2 has started a scheduled steam-generator tube leak transient. The process-plant status color should now be driven by actual I&C alarms and measured variables.",
              "objectIds": ["plant:halden-a2"],
              "dismissible": true
            }
          },
          {
            "type": "highlight_objects",
            "objectIds": ["plant:halden-a2"]
          }
        ]
      },
      {
        "id": "b1-feedwater-guidance",
        "at": { "kind": "after_scenario_start", "seconds": 125 },
        "actions": [
          {
            "type": "show_guidance",
            "guidance": {
              "id": "b1-feedwater-started",
              "title": "Unit B1 feedwater degradation",
              "tone": "update",
              "message": "Unit B1 begins a feedwater degradation path. Its rail fields should show changing output, alarms, and trip counts without a dedicated plant UI.",
              "objectIds": ["plant:halden-b1"],
              "dismissible": true
            }
          }
        ]
      },
      {
        "id": "clear-demo-highlights",
        "at": { "kind": "after_scenario_start", "seconds": 240 },
        "actions": [
          {
            "type": "clear_highlights",
            "objectIds": ["plant:halden-a2", "plant:halden-b1", "plant:halden-6-loop", "amb:demo-reserve-1"]
          }
        ]
      }
    ]
