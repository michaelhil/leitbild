[Unit]
Description=Leitbild research platform
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=leitbild
Group=leitbild
WorkingDirectory=/opt/leitbild/current
Environment=PORT=4177
Environment=LEITBILD_BIND_HOST=127.0.0.1
Environment=LEITBILD_DATA_DIR=/opt/leitbild/data
Environment=LEITBILD_MAP_ROOT=/opt/leitbild/maps
Environment=LEITBILD_ROUTING_PROVIDER=osrm
Environment=LEITBILD_OSRM_URL=http://127.0.0.1:5000
# Provider credentials (OPENSKY_CLIENT_ID, OPENSKY_CLIENT_SECRET, etc.) live
# in /etc/leitbild/runtime.env (chmod 600). The leading `-` makes the file
# optional so the service starts even before credentials are provisioned;
# missing OpenSky creds simply disable the aviation.opensky provider.
EnvironmentFile=-/etc/leitbild/runtime.env
# Docker may be active before its restart-managed OSRM container is ready.
# Bound the wait so a broken container remains a visible systemd failure.
ExecStartPre=/bin/sh -c 'for attempt in $(seq 1 60); do /usr/bin/curl -fsS -o /dev/null "http://127.0.0.1:5000/route/v1/driving/10.7522,59.9139;10.7530,59.9145?overview=false" && exit 0; sleep 1; done; exit 1'
ExecStart=/opt/leitbild/runtime/bun run src/index.ts
Restart=on-failure
RestartSec=5

MemoryMax=1G
CPUQuota=180%
LimitNOFILE=65536
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/leitbild/data
PrivateTmp=true
PrivateDevices=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
RemoveIPC=true

[Install]
WantedBy=multi-user.target
