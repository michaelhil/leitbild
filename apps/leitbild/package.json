{
  "name": "@leitbild/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start": "bun run build:ui && bun run src/index.ts",
    "dev": "bun run build:ui && bun --watch src/index.ts",
    "build:ui": "vite build",
    "check": "tsc --noEmit && vite build",
    "test": "bun run build:ui && bun test",
    "deploy": "bun run scripts/deploy.ts"
  },
  "dependencies": {
    "@leitbild/contracts": "workspace:*",
    "svelte": "^5.56.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/bun": "1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  },
  "engines": {
    "bun": "1.4.0"
  }
}
