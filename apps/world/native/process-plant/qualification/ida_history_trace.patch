# Read-only arithmetic instrumentation for private SERIAL/DOUBLE qualification.
# Applies only to UNCHANGED official SUNDIALS 7.5.0 src/ida/ida.c, BSD-3-Clause.
# Do not compose with ida_consistency.patch: both use temporary vector 3.
# No plant indices, state corrections, tolerance changes or solver decisions.
# Full-vector recurrence selects first/worst violated bounds and generic controls.
# Only four rows of old history are saved on the stack; no vector allocations.
# Floating values are JSON strings in exact C99 hexadecimal (%a) notation.
--- a/src/ida/ida.c
+++ b/src/ida/ida.c
@@ -2786,3 +2786,7 @@
   /* If otherwise successful, check and enforce inequality constraints. */
+  /* tempv3 is otherwise used only by lsetup, which has already completed.
+     Preserve the actual unscaled pre-constraint correction for this step. */
+  if (IDA_mem->ida_constraintsSet)
+    N_VScale(ONE, IDA_mem->ida_ee, IDA_mem->ida_tempv3);
 
   if (IDA_mem->ida_constraintsSet)
@@ -3170,9 +3174,142 @@
 
+/* Qualification-only operands for the stock serial history recurrence. */
+typedef struct
+{
+  int count;
+  sunindextype rows[4], violations;
+  const char* roles[4];
+  sunrealtype oldphi[4][MXORDP1], predicted[4];
+} IDAHistoryTraceSnapshot;
+
+static sunbooleantype IDAHistoryTraceFailed(sunrealtype c, sunrealtype y)
+{
+  return (SUNRabs(c) > ONEPT5 && y * c <= ZERO) ||
+         (SUNRabs(c) > HALF && y * c < ZERO);
+}
+
+static sunrealtype IDAHistoryTracePredict(IDAMem m, sunindextype i)
+{
+  int j;
+  sunrealtype sum = N_VGetArrayPointer(m->ida_ee)[i];
+  /* Serial vector-array axpy (and its unfused fallback) visits k..0.
+     Each assignment rounds the same old-phi + already-updated-column sum. */
+  for (j = m->ida_kused; j >= 0; j--)
+    sum = N_VGetArrayPointer(m->ida_phi[j])[i] + sum;
+  return sum;
+}
+
+static void IDAHistoryTraceBefore(IDAMem m, IDAHistoryTraceSnapshot* s)
+{
+  sunindextype i, n, first = -1, worst = -1, unconstrained = -1, control = -1;
+  sunrealtype severity = ZERO, predicted;
+  sunrealtype *c, *raw;
+  int j, slot;
+  s->count = 0;
+  s->violations = 0;
+  if (!m->ida_constraintsSet) return;
+  if (N_VGetVectorID(m->ida_phi[0]) != SUNDIALS_NVEC_SERIAL ||
+      m->ida_kused < 0 || m->ida_kused >= MXORDP1)
+  {
+    fputs("{\"kind\":\"ida-history-trace-error\",\"error\":\"unsupported-vector-or-order\"}\n", stderr);
+    return;
+  }
+  c = N_VGetArrayPointer(m->ida_constraints);
+  raw = N_VGetArrayPointer(m->ida_yy);
+  if (c == NULL || raw == NULL || N_VGetArrayPointer(m->ida_yp) == NULL ||
+      N_VGetArrayPointer(m->ida_yypredict) == NULL ||
+      N_VGetArrayPointer(m->ida_tempv3) == NULL ||
+      N_VGetArrayPointer(m->ida_ee) == NULL ||
+      N_VGetArrayPointer(m->ida_ewt) == NULL)
+  {
+    fputs("{\"kind\":\"ida-history-trace-error\",\"error\":\"missing-serial-data\"}\n", stderr);
+    return;
+  }
+  for (j = 0; j <= m->ida_kused; j++)
+    if (N_VGetArrayPointer(m->ida_phi[j]) == NULL)
+    {
+      fputs("{\"kind\":\"ida-history-trace-error\",\"error\":\"missing-history-data\"}\n", stderr);
+      return;
+    }
+  n = N_VGetLength(m->ida_phi[0]);
+  for (i = 0; i < n; i++)
+  {
+    predicted = IDAHistoryTracePredict(m, i);
+    if (c[i] == ZERO && unconstrained < 0) unconstrained = i;
+    if (c[i] != ZERO && predicted * c[i] > ZERO && raw[i] * c[i] > ZERO && control < 0)
+      control = i;
+    if (IDAHistoryTraceFailed(c[i], predicted))
+    {
+      s->violations++;
+      if (first < 0) first = i;
+      if (worst < 0 || predicted * c[i] < severity)
+      { worst = i; severity = predicted * c[i]; }
+    }
+  }
+  if (first < 0) return;
+  s->rows[s->count] = first; s->roles[s->count++] = "first-violation";
+  if (worst != first)
+  { s->rows[s->count] = worst; s->roles[s->count++] = "worst-violation"; }
+  if (unconstrained >= 0)
+  { s->rows[s->count] = unconstrained; s->roles[s->count++] = "unconstrained-control"; }
+  if (control >= 0)
+  { s->rows[s->count] = control; s->roles[s->count++] = "interior-control"; }
+  for (slot = 0; slot < s->count; slot++)
+  {
+    i = s->rows[slot];
+    s->predicted[slot] = IDAHistoryTracePredict(m, i);
+    for (j = 0; j <= m->ida_kused; j++)
+      s->oldphi[slot][j] = N_VGetArrayPointer(m->ida_phi[j])[i];
+  }
+}
+
+static void IDAHistoryTraceAfter(IDAMem m, const IDAHistoryTraceSnapshot* s)
+{
+  int slot, j;
+  if (s->count == 0) return;
+  fprintf(stderr, "{\"kind\":\"ida-history-constraint-trace\",\"dimension\":%lld,"
+          "\"step\":%ld,\"order\":%d,\"time\":\"%a\",\"hUsed\":\"%a\","
+          "\"cj\":\"%a\",\"violatedCoordinates\":%lld,\"rows\":[",
+          (long long)N_VGetLength(m->ida_phi[0]), m->ida_nst, m->ida_kused,
+          (double)m->ida_tn, (double)m->ida_hused, (double)m->ida_cj,
+          (long long)s->violations);
+  for (slot = 0; slot < s->count; slot++)
+  {
+    sunindextype i = s->rows[slot];
+    sunrealtype c = N_VGetArrayPointer(m->ida_constraints)[i];
+    sunrealtype raw = N_VGetArrayPointer(m->ida_yy)[i];
+    sunrealtype weight = N_VGetArrayPointer(m->ida_ewt)[i];
+    sunrealtype predictor = N_VGetArrayPointer(m->ida_yypredict)[i];
+    sunrealtype ee = N_VGetArrayPointer(m->ida_ee)[i];
+    sunrealtype actual = N_VGetArrayPointer(m->ida_phi[0])[i];
+    sunrealtype target = ((SUNRabs(c) >= ONEPT5 ? ONE : ZERO) * c) / weight;
+    target *= PT1;
+    fprintf(stderr, "%s{\"role\":\"%s\",\"row\":%lld,\"constraint\":\"%a\","
+            "\"rawFailedMask\":%s,\"target\":\"%a\",\"ewt\":\"%a\","
+            "\"predictor\":\"%a\",\"rawY\":\"%a\",\"rawYP\":\"%a\","
+            "\"eeBeforeConstraint\":\"%a\",\"eeAfterConstraint\":\"%a\","
+            "\"correctedEndpoint\":\"%a\",\"predictedPhi0\":\"%a\","
+            "\"retainedPhi0\":\"%a\",\"predictionMatches\":%s,\"oldPhi\":[",
+            slot ? "," : "", s->roles[slot], (long long)i, (double)c,
+            IDAHistoryTraceFailed(c, raw) ? "true" : "false", (double)target,
+            (double)weight, (double)predictor, (double)raw,
+            (double)N_VGetArrayPointer(m->ida_yp)[i],
+            (double)N_VGetArrayPointer(m->ida_tempv3)[i], (double)ee,
+            (double)(predictor + ee), (double)s->predicted[slot], (double)actual,
+            memcmp(&s->predicted[slot], &actual, sizeof(sunrealtype)) == 0 ? "true" : "false");
+    for (j = 0; j <= m->ida_kused; j++)
+      fprintf(stderr, "%s\"%a\"", j ? "," : "", (double)s->oldphi[slot][j]);
+    fputs("]}", stderr);
+  }
+  fputs("]}\n", stderr);
+  fflush(stderr);
+}
+
 static void IDACompleteStep(IDAMem IDA_mem, sunrealtype err_k, sunrealtype err_km1)
 {
   int j, kdiff, action;
   sunrealtype terr_k, terr_km1, terr_kp1;
   sunrealtype err_knew, err_kp1;
   sunrealtype enorm, tmp, hnew;
+  IDAHistoryTraceSnapshot trace;
 
   IDA_mem->ida_nst++;
@@ -3321,3 +3458,4 @@
   /* Update phi arrays */
+  IDAHistoryTraceBefore(IDA_mem, &trace);
 
   /* To update phi arrays compute X += Z where                  */
@@ -3335,4 +3473,5 @@
   (void)N_VLinearSumVectorArray(IDA_mem->ida_kused + 1, ONE, IDA_mem->ida_Xvecs,
                                 ONE, IDA_mem->ida_Zvecs, IDA_mem->ida_Xvecs);
+  IDAHistoryTraceAfter(IDA_mem, &trace);
 }
 
