  "deck": {
    "entries": [
      {
        "id": "brief",
        "label": "Brief the current situation",
        "description": "Ask the operator to discover the live integrated Halden run and produce an evidence-grounded Plant and Grid brief.",
        "action": {
          "kind": "post-message",
          "content": "Discover the live Halden Simulation Run in this Workspace. Read its Simulation Context, identify the scenario objectives, Plant output, Grid balance, connection state, and current alarms, then give me a concise evidence-grounded operator brief. Do not issue any command."
