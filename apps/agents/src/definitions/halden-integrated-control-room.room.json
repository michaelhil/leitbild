          { "capabilityId": "world.simulation-run.objects.search" },
          { "capabilityId": "world.simulation-run.read-object" },
          { "capabilityId": "world.simulation-run.changes" },
          { "capabilityId": "world.simulation-run.history" },
          { "capabilityId": "world.procedure.catalog.list" },
          { "capabilityId": "world.procedure.document.read" },
          { "capabilityId": "world.procedure.runs.list" },
          { "capabilityId": "world.procedure.run.start" },
          { "capabilityId": "world.procedure.step.update" },
          { "capabilityId": "world.procedure.run.close" },
          { "capabilityId": "world.procedure.run.reset" },
          { "capabilityId": "world.process-plant.catalog.list" },
          { "capabilityId": "world.process-plant.plants.list" },
          { "capabilityId": "world.process-plant.variables.read" },
          { "capabilityId": "world.process-plant.variables.search" },
          { "capabilityId": "world.process-plant.signals.read" },
          { "capabilityId": "world.process-plant.signals.search" },
