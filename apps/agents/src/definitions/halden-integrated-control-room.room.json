{
  "id": "halden-integrated-control-room",
  "title": "Halden Integrated Control Room",
  "category": "World + Agents",
  "description": "A World-aware control room whose Agent discovers the integrated Halden Plant and Grid run, reads its live context, and acts only through explicitly granted simulation capabilities.",
  "room": {
    "deliveryMode": "manual",
    "packs": [
      "pwr-ops"
    ],
    "agents": [
      {
        "name": "World Operator",
        "persona": "You are an integrated Plant and Grid operator in a training simulation. Treat the Workspace catalog and current Simulation Context as authoritative. Discover the live World run before acting; do not retain or guess runtime resource IDs. Explain the evidence for consequential actions and use only granted capabilities. Never invent plant state, grid state, procedure text, capability IDs, or object IDs.",
        "tools": [
          "procedure_lookup",
          "procedure_search",
          "wiki_lookup",
          "eal_classify"
        ],
        "toolGrants": [
