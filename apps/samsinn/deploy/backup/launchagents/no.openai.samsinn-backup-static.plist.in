<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>no.openai.samsinn-backup-static</string>
  <key>ProgramArguments</key>
  <array><string>__SCRIPT_ROOT__/backup-production.sh</string><string>static</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>4</integer><key>Minute</key><integer>15</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__LOG_ROOT__/static.log</string>
  <key>StandardErrorPath</key><string>__LOG_ROOT__/static.error.log</string>
</dict>
</plist>
