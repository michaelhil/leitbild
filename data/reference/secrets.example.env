# Reference-data pipeline secrets. Example only.
#
# In production this file lives at /etc/leitbild/reference.env on the deploy
# host, chmod 600, owned by root. Load it only for an explicitly approved
# reference-data build from /opt/leitbild/current.
#
# Never commit a real key. The example file is tracked so newcomers know what
# variables exist and where to set them; the real one is gitignored.

# Required for OpenAIP airspace fetches. Generate at https://accounts.openaip.net
OPENAIP_API_KEY=

# Optional: distinct User-Agent for GeoNorge WFS requests. Falls back to a
# leitbild/<version> string if unset.
# GEONORGE_USER_AGENT=

# Optional: override the reference-data on-disk root. Defaults to
# /opt/leitbild/reference on the deploy host.
# LEITBILD_REFERENCE_ROOT=/opt/leitbild/reference
