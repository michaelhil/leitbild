{
  "name": "samsinn",
  "version": "0.15.0",
  "description": "Multi-agent room communication system with multi-instance deploy, delivery modes, scripts (improv scenes), MCP server, and bug reporting to GitHub",
  "module": "src/index.ts",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "start": "bun run build:css && bun run src/main.ts",
    "start:remote": "OLLAMA_URL=http://192.168.0.222:11434 bun run start",
    "dev": "bun run scripts/dev.ts",
    "dev:remote": "OLLAMA_URL=http://192.168.0.222:11434 bun run scripts/dev.ts",
    "build:css": "bun run tailwindcss -i src/ui/input.css -o src/ui/dist.css --minify",
    "dev:server": "bun --watch src/main.ts",
    "dev:css": "bun run tailwindcss -i src/ui/input.css -o src/ui/dist.css --watch",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "check:server": "tsc --noEmit",
    "check:ui": "tsc --noEmit -p tsconfig.ui.json",
    "test": "bun test",
    "test:unit": "bun test -t '^(?!.*Ollama)'",
    "headless": "bun run src/main.ts --headless",
    "deploy": "bun run scripts/deploy.ts",
    "set-env": "bun run scripts/set-env.ts",
    "drift": "bun run scripts/check-deploy-drift.ts",
    "smoke": "bun run scripts/smoke-streaming.ts",
    "health": "bash scripts/health.sh"
  },
  "keywords": ["agents", "multi-agent", "llm", "ollama", "communication", "rooms", "bun", "typescript"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelhil/samsinn"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4",
    "@types/bun": "1.3.11",
    "dependency-cruiser": "18.2.0",
    "knip": "6.32.3",
    "tailwindcss": "^4",
    "type-coverage": "2.30.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "unpdf": "^1.6.2",
    "zod": "^3.25 || ^4.0"
  }
}
